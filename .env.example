# =============================================================================
# Cloud-Based AI Chatbot - Environment Configuration Template
# High Performance Cloud Computing Mini-Project
# =============================================================================
# Instructions:
# 1. Copy this file and rename it to ".env"
# 2. Add your OpenRouter API key below
# 3. NEVER commit the actual ".env" file to GitHub or public repositories!
# =============================================================================

# OpenRouter API Key (Get yours from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model Selection on OpenRouter (Supports Google Gemini Flash models)
# Recommended options:
# - google/gemini-3.7-flash (Next-gen hybrid reasoning Gemini Flash)
# - google/gemini-2.5-flash (Fast, high-quality, multimodal)
OPENROUTER_MODEL=google/gemini-3.7-flash

# Enable Web Search Grounding for current information (true / false)
ENABLE_WEB_SEARCH=true

# Flask Session Security Key (Any long random string used to sign session cookies)
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-for-session-encryption

# Local Development Server Settings
FLASK_DEBUG=True
PORT=5000

# =============================================================================
# Microsoft Azure Cloud Services Integration (Advanced Stage Roadmap)
# =============================================================================
# Stage 2: Azure Blob Storage (For persistent cloud file storage)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER_NAME=chatbot-uploads

# Stage 3: Azure Application Insights (For cloud telemetry & performance tracking)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Stage 4: Azure Key Vault (For cloud secret management)
# AZURE_KEY_VAULT_URL=https://<your-vault-name>.vault.azure.net/
